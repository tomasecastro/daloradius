# Copy this file to .env before running Docker Compose.
# Replace every CHANGE_ME_... value with deployment-specific secrets.
#
# Root Compose loads environment variables from `.env` automatically.
# Standalone Compose files also load `.env` from the project root when run
# from there. Do NOT use --project-directory with standalone files, as it
# changes relative path resolution and will break volume/secret mounts.
# Use instead:
#   docker compose -f docker/<service>/docker-compose.yml up -d
#
# Docker Secrets (secrets/db/ + secrets/daloradius/) ARE wired into the
# standalone compose files (via `secrets:` sections). See secrets/README.md.
#
# The root docker-compose.yml is auto-generated by setup/install-docker-compose.sh.
# Run it instead of manually copying this file.
#
# ⚠️ Passwords are not stored here — they come exclusively from Docker Secrets
# (secrets/db/* and secrets/daloradius/*). The install script generates them.
# These CHANGE_ME_* placeholders are kept as fallback markers for the installer
# to detect and replace when writing .env for root compose compatibility.

# === Connection settings (overridable) ===
MYSQL_HOST=radius-mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: host port for MariaDB (defaults to 3306, same as internal).
# Set a different value (e.g., 3307) to avoid conflicts with a local MariaDB.
# Internal service-to-service connections always use MYSQL_PORT (3306).
MYSQL_HOST_PORT=3306
MYSQL_USER=radius
MYSQL_DATABASE=radius
MYSQL_WAIT_INTERVAL=5

# === FreeRADIUS ===
# FREERADIUS_SQL_TLS: disabled (default), require (enforce TLS), or enabled (opportunistic TLS)
FREERADIUS_SQL_TLS=disabled

# === Optional settings ===
TZ=Europe/Vienna
DALORADIUS_OPERATORS_BIND=0.0.0.0:8000
MYSQL_BIND_ADDRESS=0.0.0.0
MYSQL_HEALTH_START_PERIOD=10m
MAIL_SMTPADDR=127.0.0.1
MAIL_PORT=25
MAIL_FROM=root@daloradius.example.com
MAIL_AUTH=

# Operator authentication. LDAP URI and allowed groups must be JSON arrays.
# Keep local auth enabled until LDAP login and local recovery are verified.
DALORADIUS_OPERATOR_AUTH_LOCAL_ENABLED=true
DALORADIUS_OPERATOR_AUTH_LDAP_ENABLED=false
DALORADIUS_OPERATOR_AUTH_DEFAULT=local
DALORADIUS_LDAP_URI=[]
DALORADIUS_LDAP_SECURITY=starttls
DALORADIUS_LDAP_TLS_VERIFY=true
DALORADIUS_LDAP_TLS_CA_FILE=
DALORADIUS_LDAP_BASE_DN=
DALORADIUS_LDAP_USER_BASE_DN=
DALORADIUS_LDAP_BIND_DN=
# Set this only in a protected .env; it overrides the PHP config at runtime.
DALORADIUS_LDAP_BIND_PASSWORD=
DALORADIUS_LDAP_FILTER=
# Required when LDAP is enabled; use an immutable directory attribute such as
# objectGUID (Active Directory) or entryUUID (OpenLDAP), never a mutable login name.
DALORADIUS_LDAP_EXTERNAL_ID_ATTRIBUTE=
DALORADIUS_LDAP_TIMEOUT=5
DALORADIUS_LDAP_ALLOWED_GROUPS=[]
DALORADIUS_LDAP_GROUP_ATTRIBUTE=memberOf
# Active Directory nested groups: 1.2.840.113556.1.4.1941
DALORADIUS_LDAP_GROUP_MATCHING_RULE=
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=

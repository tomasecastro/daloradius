# Certificates are generated/seeded at runtime (Spec 015). Never commit them:
# private_ext/server.key is a private key.
docker/freeradius/ssl/cert_ext/*
docker/freeradius/ssl/private_ext/*
!docker/freeradius/ssl/cert_ext/.gitkeep
!docker/freeradius/ssl/private_ext/.gitkeep

app/common/includes/daloradius.conf.php
app/common/library/htmlpurifier/HTMLPurifier/DefinitionCache/Serializer/HTML/*

.amp/portals/*

.specify/*

graphify-out/*
.git-rewrite/*
# [021] copia runtime de constitution (no versionar)
.specify/constitution.md

